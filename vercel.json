{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "web",
      "framework": "vite",
      "buildCommand": "node scripts/vercel-check-data.mjs && npm run build && node scripts/vercel-prune-dist.mjs"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
